# Copy to .env for local dev. Never commit the real .env.

# Server port
PORT=3000

# Seeded users, upserted into the user table on boot. Comma-separated username:password.
# Password is plaintext (hashed with scrypt on boot) OR a pre-hashed value "scrypt$<salt>$<hash>".
# Split on the first colon, so passwords may contain ":" but not ",".
# USERS=alice:changeme,bob:changeme

# Session signing secret (HMAC). Required when NODE_ENV=production (e.g. `openssl rand -hex 32`).
# Cookies are `Secure` in production only.
# SESSION_SECRET=

# Anthropic API key for AI assist (issue #30, opt-in only)
# ANTHROPIC_API_KEY=
